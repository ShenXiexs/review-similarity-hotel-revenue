. version 17.0

. clear all

. set more off

. set linesize 255

. capture log close

. mata: mata set matafavor speed

. 
. local project "/Users/samxie/Research/ReviewSimi_Sales/Code"

. local out_root "`project'/outputs/core_simi_260501"

. local data_dir "`out_root'/data"

. local csv_dir "`out_root'/csv"

. local scan_dir "`out_root'/scans"

. local table_dir "`out_root'/tables"

. local log_dir "`out_root'/logs"

. local run_id "260501"

. 
. cap mkdir "`out_root'"

. cap mkdir "`data_dir'"

. cap mkdir "`csv_dir'"

. cap mkdir "`scan_dir'"

. cap mkdir "`table_dir'"

. cap mkdir "`log_dir'"

. 
. local data_main "`data_dir'/core_simi_panel_`run_id'.dta"

. local gmm_candidates_csv "`csv_dir'/h1_gmm_candidates_`run_id'.csv"

. local hetero_selected_csv "`csv_dir'/heterogeneity_selected_`run_id'.csv"

. 
. capture confirm file "`data_main'"

. if _rc {
.     di as error "Cannot find `data_main'. Run scripts/r/build_core_simi_panel_260501.R first."
.     exit 601
. }

. 
. program define build_panel_state
  1.     capture drop hotel_id_num
  2.     capture confirm numeric variable HotelID
  3.     if _rc {
  4.         encode HotelID, gen(hotel_id_num)
  5.     }
  6.     else {
  7.         gen long hotel_id_num = HotelID
  8.     }
  9.     capture drop ym
 10.     gen ym = monthly(year_month, "YM")
 11.     format ym %tm
 12.     xtset hotel_id_num ym
 13.     sort hotel_id_num ym
 14.     capture drop cs_covid2020 cs_covid2021 cs_covid2022
 15.     gen byte cs_covid2020 = (Year == 2020)
 16.     gen byte cs_covid2021 = (Year == 2021)
 17.     gen byte cs_covid2022 = (Year == 2022)
 18. end

. 
. program define set_cs_controls, rclass
  1.     syntax, FAMILY(string)
  2.     if "`family'" == "rich8_current" {
  3.         return local controls "ln_recent_volumn recent_sd ln_lag_volumn_acc lag_avg_rating_acc lag_sd_acc lag_avg_rating_month ln_avg_com_RevPAR ln_lag_RevPAR_clean"
  4.     }
  5.     else if "`family'" == "quality6" {
  6.         return local controls "ln_recent_volumn ln_lag_volumn_acc lag_avg_rating_acc lag_avg_rating_month ln_avg_com_RevPAR review_freshness ln_lag_RevPAR_clean"
  7.     }
  8.     else if "`family'" == "base4_acc" {
  9.         return local controls "ln_recent_volumn ln_lag_volumn_acc lag_avg_rating_acc ln_avg_com_RevPAR ln_lag_RevPAR_clean"
 10.     }
 11.     else if "`family'" == "base4_month" {
 12.         return local controls "ln_recent_volumn ln_lag_volumn_acc lag_avg_rating_month ln_avg_com_RevPAR ln_lag_RevPAR_clean"
 13.     }
 14.     else if "`family'" == "lean3" {
 15.         return local controls "ln_recent_volumn ln_lag_volumn_acc ln_avg_com_RevPAR ln_lag_RevPAR_clean"
 16.     }
 17.     else if "`family'" == "momentum_plus" {
 18.         return local controls "ln_recent_volumn ln_lag_volumn_acc lag_avg_rating_acc ln_avg_com_RevPAR rating_momentum volume_momentum review_freshness ln_lag_RevPAR_clean"
 19.     }
 20.     else {
 21.         di as error "Unknown control family: `family'"
 22.         exit 198
 23.     }
 24. end

. 
. program define set_cs_sample, rclass
  1.     syntax, SAMPLE(string)
  2.     if "`sample'" == "full" {
  3.         return local condition "cs_sample_full == 1"
  4.     }
  5.     else if "`sample'" == "pre2020" {
  6.         return local condition "cs_sample_pre2020 == 1"
  7.     }
  8.     else if "`sample'" == "exclude2020" {
  9.         return local condition "cs_sample_exclude2020 == 1"
 10.     }
 11.     else if "`sample'" == "post2013" {
 12.         return local condition "cs_sample_post2013 == 1"
 13.     }
 14.     else if "`sample'" == "post2013_excl2020" {
 15.         return local condition "cs_sample_post2013_excl2020 == 1"
 16.     }
 17.     else if "`sample'" == "focus50" {
 18.         return local condition "cs_sample_focus50 == 1"
 19.     }
 20.     else if "`sample'" == "focus100" {
 21.         return local condition "cs_sample_focus100 == 1"
 22.     }
 23.     else if "`sample'" == "star_observed" {
 24.         return local condition "cs_sample_star_observed == 1"
 25.     }
 26.     else {
 27.         di as error "Unknown sample: `sample'"
 28.         exit 198
 29.     }
 30. end

. 
. program define run_cs_gmm
  1.     syntax, DEP(string) CTRL(string) SAMPLE(string) TIMEFE(string) DYN(string) ///
>         YLAG1(integer) YLAG2(integer) XLAG1(integer) XLAG2(integer) XSTYLE(string) [TRANSFORM(string) LOUD]
  2. 
.     set_cs_controls, family("`ctrl'")
  3.     local rhs "`r(controls)'"
  4.     set_cs_sample, sample("`sample'")
  5.     local ifcond "`r(condition)'"
  6. 
.     local tf_rhs ""
  7.     local tf_iv ""
  8.     if "`timefe'" == "monthfe" {
  9.         local tf_rhs "i.Mon"
 10.         local tf_iv "i.Mon"
 11.     }
 12.     else if "`timefe'" == "yearmon" {
 13.         local tf_rhs "i.Year i.Mon"
 14.         local tf_iv "i.Year i.Mon"
 15.     }
 16.     else if "`timefe'" == "covidmon" {
 17.         local tf_rhs "cs_covid2020 cs_covid2021 cs_covid2022 i.Mon"
 18.         local tf_iv "cs_covid2020 cs_covid2021 cs_covid2022 i.Mon"
 19.     }
 20.     else {
 21.         error 198
 22.     }
 23. 
.     local lag_rhs "L.`dep'"
 24.     local gmm_y "L.`dep'"
 25.     if "`dyn'" == "L12" {
 26.         local lag_rhs "L.`dep' L2.`dep'"
 27.         local gmm_y "L.`dep' L2.`dep'"
 28.     }
 29. 
.     local transform_opt ""
 30.     if "`transform'" == "orth" {
 31.         local transform_opt "orthogonal"
 32.     }
 33. 
.     local run_prefix "quietly"
 34.     if "`loud'" != "" {
 35.         local run_prefix "noisily"
 36.     }
 37. 
.     local x_gmm ""
 38.     local x_iv "`rhs' `tf_iv'"
 39.     if "`xstyle'" == "gmm" {
 40.         local x_gmm "gmm(sim_mean, laglimits(`xlag1' `xlag2') collapse)"
 41.     }
 42.     else if "`xstyle'" == "iv" {
 43.         local x_iv "sim_mean `rhs' `tf_iv'"
 44.     }
 45.     else {
 46.         error 198
 47.     }
 48. 
.     `run_prefix' xtabond2 `dep' `lag_rhs' sim_mean `rhs' `tf_rhs' if `ifcond', ///
>         gmm(`gmm_y', laglimits(`ylag1' `ylag2') collapse) ///
>         `x_gmm' ///
>         iv(`x_iv') twostep robust small `transform_opt'
 49. end

. 
