109.         capture noisily run_cs_gmm, dep(`dep') ctrl(`ctrl') sample(`sample') timefe(`timefe') dyn(`dyn') ///
>             ylag1(`y1') ylag2(`y2') xlag1(`x1') xlag2(`x2') xstyle(`xstyle') transform(`transform')
