. format ym %tm

. capture drop ln_RevPAR_clean_w199 ln_RevPAR_clean_w595 ln_lag_RevPAR_clean_w199 ln_lag_RevPAR_clean_w595

. * Use Stata's built-in percentile command so the replication does not depend
. * on the user-installed winsor2 package.
. foreach x in ln_RevPAR_clean ln_lag_RevPAR_clean {
  2.     quietly _pctile `x' if !missing(`x'), p(1 99)
  3.     local p1 = r(r1)
  4.     local p99 = r(r2)
  5.     gen double `x'_w199 = `x'
  6.     replace `x'_w199 = min(max(`x', `p1'), `p99') if !missing(`x')
  7.     quietly _pctile `x' if !missing(`x'), p(5 95)
  8.     local p5 = r(r1)
  9.     local p95 = r(r2)
 10.     gen double `x'_w595 = `x'
 11.     replace `x'_w595 = min(max(`x', `p5'), `p95') if !missing(`x')
 12. }
