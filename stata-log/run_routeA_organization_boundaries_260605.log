>     2 "1.5" ///
>     3 "2.0" ///
>     4 "2.5" ///
>     5 "3.0" ///
>     6 "3.5" ///
>     7 "4.0" ///
>     8 "4.5" ///
>     9 "5.0"

. capture label values star_class_final star_class_final_lbl

. 
